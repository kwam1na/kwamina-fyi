# Browser issue collection stays disabled until provider retention, access,
# quotas, ownership, alerting, and privacy-envelope checks are recorded.
OBSERVABILITY_PROVIDER_READY=false
VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0

# Manual page views and Core Web Vitals stay off until the Simple Analytics
# site and privacy settings have been verified for the production domain.
VITE_SIMPLE_ANALYTICS_READY=false

# Production source-map upload settings. SENTRY_AUTH_TOKEN is CI-only: never
# use a VITE_ prefix or put its value in a committed/local environment file.
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=kwamina-fyi-browser
SENTRY_RELEASE=kwamina-fyi@0123456789abcdef
# SENTRY_AUTH_TOKEN is supplied only by the protected CI environment.
