{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwamina-fyi",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback answers /api/* with index.html: the asset
    // worker runs first and treats an unmatched path as a client route. Naming
    // the API prefix here is what lets the Worker script see those requests at
    // all; everything else still goes straight to assets.
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Per-IP ceiling on the chat endpoint. The D1 limits are per conversation,
  // so a script that mints a fresh thread id per request walks straight past
  // them; this is keyed on the caller instead. Counters are per Cloudflare
  // location rather than global, so the real ceiling is this number times the
  // locations an attacker spreads across — a cost ceiling, not an access
  // control.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwamina-fyi-chat",
      "database_id": "4da7cab4-55be-4b92-8a01-af99d1bc1807",
      "migrations_dir": "./migrations"
    }
  ],
  // Hourly sweep of expired rate-limit counters (see scheduled() in the Worker).
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
