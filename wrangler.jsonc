{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwamina-fyi",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    // Automatic traces currently include request metadata. Keep them off until
    // exported credential-bearing envelopes pass the privacy gate.
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0
    }
  },
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback answers /api/* with index.html: the asset
    // worker runs first and treats an unmatched path as a client route. Naming
    // the API prefix here is what lets the Worker script see those requests at
    // all; everything else still goes straight to assets.
    "run_worker_first": [
      "/api/*"
    ]
  },
  // Per-IP burst ceiling on the chat endpoint. Like the D1 backstop, this is
  // keyed on the caller, so minting fresh thread ids does not reset it.
  // Counters are per Cloudflare
  // location rather than global, so the real ceiling is this number times the
  // locations an attacker spreads across — a cost ceiling, not an access
  // control.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kwamina-fyi-chat",
      "database_id": "4da7cab4-55be-4b92-8a01-af99d1bc1807",
      "migrations_dir": "./migrations"
    }
  ],
  // Hourly sweep of expired rate-limit counters (see scheduled() in the Worker).
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
