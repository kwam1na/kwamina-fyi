{
  "name": "kwamina-fyi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "corpus": "node scripts/build-corpus.mjs",
    "dev": "bun run corpus && vite",
    "build": "bun run corpus && vite build",
    "build:ci": "bun run build && sh scripts/ci-migrate.sh",
    "test": "bun run corpus && bun test && python3 -m unittest discover -s docs/content/tests -t docs/content/tests",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler d1 migrations list kwamina-fyi-chat --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply kwamina-fyi-chat",
    "db:migrate:remote": "wrangler d1 migrations apply kwamina-fyi-chat --remote"
  },
  "dependencies": {
    "@sentry/cloudflare": "10.69.0",
    "@sentry/react": "10.69.0",
    "@tanstack/ai": "0.43.1",
    "@tanstack/ai-anthropic": "0.16.4",
    "@tanstack/ai-react": "0.19.1",
    "@tanstack/react-router": "^1.170.17",
    "@vitejs/plugin-react": "latest",
    "animejs": "^4.5.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "wrangler": "^4.114.0"
  }
}
