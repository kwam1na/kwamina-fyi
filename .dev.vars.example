# Copy to .dev.vars for local development (`bun run preview`).
# In production this is set with: wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# Dedicated HMAC key for privacy-preserving D1 rate-limit identifiers.
# Generate a random value; do not reuse the Anthropic or evaluation secret.
RATE_LIMIT_KEY=replace-with-a-random-secret

# Production archive bindings are intentionally omitted here: localhost is
# admitted without Access so the local inspector remains easy to use. Before
# enabling production, set CONVERSATION_ARCHIVE_ENABLED,
# CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, and CF_ACCESS_ALLOWED_EMAIL with
# `wrangler secret put` after the Access application exists.
